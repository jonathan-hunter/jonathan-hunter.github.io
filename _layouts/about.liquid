---
layout: default
---
<!--
  Mass-spectrum animated banner. All assets are user-owned:
  - _sass/_mass-spectrum-styles.scss (imported from assets/css/main.scss)
  - assets/js/mass-spectrum-background.js
  Placed above the page title so it sits below the navbar/link toolbar.
-->
<div id="mass-spectrum-background" data-max-height="33.333" data-min-height="8.333">
  <canvas id="mass-spectrum-canvas" class="mass-spectrum-canvas" data-variant="hero"></canvas>
</div>

<div class="post">
  <!-- Hero: eyebrow, name, lede and contact rail, with the portrait at right. -->
  <section class="jeh-hero">
    <div>
      {% if page.eyebrow %}
        <div class="jeh-hero__eyebrow">{{ page.eyebrow }}</div>
      {% endif %}
      <h1 class="jeh-hero__name">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if page.lede %}
        <p class="jeh-hero__lede">{{ page.lede }}</p>
      {% endif %}
      {% include jeh_contact_links.liquid %}
    </div>

    {% if page.profile and page.profile.image %}
      <div class="jeh-hero__portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path sizes="220px" alt=page.profile.image
          cache_bust=true
        %}
      </div>
    {% endif %}
  </section>

  <article>
    <!-- Intro prose and partner logos, authored in _pages/about.md -->
    {{ content }}

    <div class="spectrum-divider" style="margin-top: 44px">
      <canvas class="mass-spectrum-canvas" data-variant="divider-stems-fade"></canvas>
    </div>

    <div class="jeh-home-cols">
      <!-- Selected papers -->
      {% if page.selected_papers %}
        <div>
          <h2 class="jeh-col-head">Selected papers</h2>
          {% include selected_papers.liquid %}
          <div class="jeh-col-more">
            <a href="{{ '/publications/' | relative_url }}">all publications &rarr;</a>
          </div>
        </div>
      {% endif %}

      <!-- Latest news and posts, merged into one date-ordered feed -->
      {% if page.announcements and page.announcements.enabled %}
        <div>
          <h2 class="jeh-col-head">Latest news &amp; posts</h2>
          {% include jeh_feed.liquid limit=page.announcements.limit %}
          <div class="jeh-col-more">
            <a href="{{ '/news/' | relative_url }}">all news &rarr;</a>
            <a href="{{ '/blog/' | relative_url }}">all posts &rarr;</a>
          </div>
        </div>
      {% endif %}
    </div>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

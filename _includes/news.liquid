{% comment %}
  News timeline: a date rail beside each item body, grouped under large serif
  year headings. Long-form announcements render in full; inline ones are a
  single line of copy.

  Params:
    limit — when set with page.announcements.limit, caps the number of rows
{% endcomment %}

<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | sort: 'date' | reverse %}
    {% assign news_size = news | size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <div class="jeh-news">
      {% assign current_year = '' %}
      {% for item in news limit: news_limit %}
        {% assign item_year = item.date | date: '%Y' %}
        {% if item_year != current_year %}
          <div class="jeh-news__year">{{ item_year }}</div>
          {% assign current_year = item_year %}
        {% endif %}

        <div class="jeh-news__date">{{ item.date | date: '%b %-d, %Y' }}</div>
        <div class="jeh-news__body">
          {% if item.inline %}
            {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
          {% else %}
            <a class="jeh-news__title news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {{ item.content }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
